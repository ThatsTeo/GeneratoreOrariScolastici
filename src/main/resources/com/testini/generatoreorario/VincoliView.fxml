<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="460.0" spacing="14.0" style="-fx-background-color: #2b2b2b;" styleClass="vincoli-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.testini.generatoreorario.GUI.VincoliController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>

    <Label fx:id="labelVincoli" text="Scegli i vincoli" textFill="#ff5555" wrapText="true" textAlignment="CENTER">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <VBox spacing="10.0" styleClass="vincoli-card">
        <Label styleClass="vincoli-sezione" text="FASCE ORARIE" />
        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints halignment="RIGHT" />
            </columnConstraints>
            <Label styleClass="vincoli-label" text="Può insegnare alla prima ora" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <CheckBox fx:id="primaOraCheck" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label styleClass="vincoli-label" text="Può insegnare all'ultima ora" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <CheckBox fx:id="ultimaOraCheck" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        </GridPane>
    </VBox>

    <VBox spacing="10.0" styleClass="vincoli-card">
        <Label styleClass="vincoli-sezione" text="CARICO E CONTINUITÀ" />
        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints halignment="RIGHT" />
            </columnConstraints>
            <Label styleClass="vincoli-label" text="Ore minime consecutive" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Spinner fx:id="oreConsecSlider" editable="true" prefHeight="28.0" prefWidth="75.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label styleClass="vincoli-label" text="Ore massime consecutive" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Spinner fx:id="oreConsMaxSpinner" editable="true" prefHeight="28.0" prefWidth="75.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label styleClass="vincoli-label" text="Ore massime per giorno" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <HBox alignment="CENTER_RIGHT" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <ComboBox fx:id="maxOreGiornoCB" prefHeight="28.0" prefWidth="112.0" />
                <Spinner fx:id="maxOreGiornoSpinner" prefHeight="28.0" prefWidth="75.0" />
            </HBox>
        </GridPane>
    </VBox>

    <Button onAction="#onChiudi" prefHeight="34.0" prefWidth="160.0" styleClass="modificavincoli-button" text="Salva e Chiudi" />
</VBox>
