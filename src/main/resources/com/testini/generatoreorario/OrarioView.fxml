<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<VBox alignment="TOP_CENTER" prefHeight="540.0" prefWidth="780.0" spacing="15.0" style="-fx-background-color: #2b2b2b;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.testini.generatoreorario.GUI.OrarioController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <Label fx:id="labelOrario" text="Tabella Orario" textFill="WHITE">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Docente:" textFill="WHITE">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <ComboBox fx:id="comboBoxDocenti" prefWidth="250.0" promptText="Seleziona Docente" />
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background: #2b2b2b; -fx-background-color: #2b2b2b;">
        <VBox alignment="CENTER">
            <GridPane fx:id="grigliaOrario" alignment="CENTER" hgap="6.0" vgap="6.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </GridPane>
        </VBox>
    </ScrollPane>
</VBox>
